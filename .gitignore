# ==========================================
# Root .gitignore for Fullstack Django + Next.js
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.playwright-mcp/

# Environment Variables & Secrets
.env
.env.*
.env*.local
!.env.example
*.pem
*.key

# ------------------------------------------
# Backend (Python / Django / Celery)
# ------------------------------------------
**/__pycache__/
**/*.py[cod]
**/*$py.class
*.so
.Python
**/venv/
**/env/
**/ENV/
**/.venv/
env.bak/
venv.bak/

# Django Database & Static/Media
#*.sqlite3
*.sqlite3-journal
#db.sqlite3
**/media/
# Only ignore user-uploaded media files inside media_libm, not the Django app source code
backend/media_libm/uploads/
backend/media_libm/products/
**/staticfiles/
local_settings.py

# Celery & Redis
celerybeat-schedule
celerybeat.pid
*.rdb
dump.rdb

# Python Testing & Coverage
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# ------------------------------------------
# Frontend (Node / Next.js / TypeScript)
# ------------------------------------------
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Frontend Testing & Coverage
**/coverage/
.nyc_output/

# Frontend Deployment
.vercel/

# TypeScript Cache
*.tsbuildinfo

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# AI Skills & Agent Configurations
# ------------------------------------------
.agents/
.agent/
.gemini/
.claude/
.cursor/
.skills/

# Graphify
.graphify*
GRAPH_REPORT.md

# Impeccable & Taste Design Systems
.impeccable/
.taste/

# Caveman
.caveman/
.cavemem/
.caveman-learn/
caveman.json
CLAUDE.md
CLAUDE.original.md
*.original.md

AUDIT_FINDINGS.md

assets/*
