# ==========================================
# Root .gitignore for Fullstack Django + Next.js
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets
.env
.env.*
.env*.local
!.env.example
*.pem
*.key

# ------------------------------------------
# Backend (Python / Django / Celery)
# ------------------------------------------
**/__pycache__/
**/*.py[cod]
**/*$py.class
*.so
.Python
**/venv/
**/env/
**/ENV/
**/.venv/
env.bak/
venv.bak/

# Django Database & Static/Media
*.sqlite3
*.sqlite3-journal
db.sqlite3
**/media/
**/staticfiles/
local_settings.py

# Celery
celerybeat-schedule
celerybeat.pid

# Python Testing & Coverage
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# ------------------------------------------
# Frontend (Node / Next.js / TypeScript)
# ------------------------------------------
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Frontend Testing & Coverage
**/coverage/
.nyc_output/

# Frontend Deployment
.vercel/

# TypeScript Cache
*.tsbuildinfo

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
