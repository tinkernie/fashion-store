# =====================================================================
# fashion-store ENVIRONMENT CONTRACT
# repo copy = structural contract (fail-closed defaults).
# The real values live ONLY in the server-side backend/.env (chmod 600,
# never committed). Local dev keeps its own .env with DEBUG=True.
# =====================================================================

DJANGO_SETTINGS_MODULE=config.settings

# --- Core (required in production; recommended in local as well) ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
STATIC_ROOT=

# --- Database: PostgreSQL is the production default ---
DB_ENGINE=postgres
POSTGRES_DB=webstore
POSTGRES_USER=store_user
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# DB_ENGINE=sqlite is a local-only quick-start mode. Never in production.

# --- Redis (broker DB0 / cache+sessions DB1) ---
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Security (all True once HTTPS via Let's Encrypt is live) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Set while any TLS-terminating proxy sits in front of Django
SECURE_PROXY_SSL_HEADER=1
CSRF_TRUSTED_ORIGINS=

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# --- SMS (sms.ir) ---
# Empty SMS_IR_API_KEY = SMS mocked: OTP codes are only logged server-side.
# Never run production signups with an empty key after provider approval.
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=300021152280
# Per-purpose workspace templates (owner-provided): signup 875605,
# password-reset 120372. Unmapped purposes fall back to generic template.
SMS_IR_TEMPLATE_SIGNUP=875605
SMS_IR_TEMPLATE_RESET=120372
SMS_IR_OTP_TEMPLATE_ID=919633
SMS_IR_OTP_PARAM=Code
OTP_LENGTH=5
OTP_EXPIRY_SECONDS=360
OTP_RESEND_SECONDS=120
OTP_MAX_ATTEMPTS=5

# --- Payments ---
# True = checkout can complete without real money (mock gateway).
# Allowed TEMPORARILY during provider-approved-window only. Flip to
# False (+ integrate a real gateway) before commercial launch.
ALLOW_DUMMY_GATEWAY=True

# --- Observability / optional storage ---
# SENTRY_DSN=
# USE_S3=True
