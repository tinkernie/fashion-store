# Django - L3: production fail-closed defaults
SECRET_KEY=change-me-to-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,api.example.com
DJANGO_SETTINGS_MODULE=config.settings

# Database (choose one)
# SQLite (default, no env needed)
# Postgres
# POSTGRES_DB=luxe_db
# POSTGRES_USER=luxe_user
# POSTGRES_PASSWORD=supersecret
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Security hardening - must be True in production when DEBUG=False (L3)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True

# CORS - restrict to frontend domains only
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://example.com
CORS_ALLOW_CREDENTIALS=True

# Frontend
FRONTEND_URL=https://example.com
DEFAULT_FROM_EMAIL=noreply@example.com

# Email — env-switched: console if DEBUG else smtp
# Options: django.core.mail.backends.console.EmailBackend | smtp | sendgrid
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.xxxxx
EMAIL_TIMEOUT=10
SENDGRID_API_KEY=
AWS_SES_REGION=us-east-1

# SMS — Kavenegar (Iran)
# Get from https://panel.kavenegar.com/Client/setting/account
KAVENEGAR_API_KEY=
SMS_SENDER=10008642
# If KAVENEGAR_API_KEY empty, SMS is mocked (logged only)

# Redis (broker + cache) - separate DBs
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
ALLOW_DUMMY_GATEWAY=False

# Payments
# ALLOW_DUMMY_GATEWAY=True only for local testing, never in production

# Object Storage (optional S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
