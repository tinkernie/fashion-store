# Django - L3: production fail-closed defaults
SECRET_KEY=change-me-to-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,api.example.com
DJANGO_SETTINGS_MODULE=config.settings

# Database (choose one)
# SQLite (default, no env needed)
# Postgres
# POSTGRES_DB=luxe_db
# POSTGRES_USER=luxe_user
# POSTGRES_PASSWORD=supersecret
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Security hardening - must be True in production when DEBUG=False (L3)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True

# CORS - restrict to frontend domains only
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://example.com
CORS_ALLOW_CREDENTIALS=True

# Frontend
FRONTEND_URL=https://example.com

# SMS - sms.ir (Iran), email system removed
# Get X-API-KEY from https://app.sms.ir panel
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=300021152280
SMS_IR_OTP_TEMPLATE_ID=919633
SMS_IR_OTP_PARAM=Code
OTP_LENGTH=5
OTP_EXPIRY_SECONDS=180
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# If SMS_IR_API_KEY empty, SMS is mocked (logged only)

# Redis (broker + cache) - separate DBs
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
ALLOW_DUMMY_GATEWAY=False

# Payments
# ALLOW_DUMMY_GATEWAY=True only for local testing, never in production

# Object Storage (optional S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
